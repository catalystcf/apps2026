{
  "name": "apps2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "screenshots": "node scripts/screenshot-keyboard.js",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});if(fs.existsSync('src'))fs.cpSync('src','dist',{recursive:true});else fs.mkdirSync('dist')\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.3"
  }
}
